{
  "name": "honey-chain",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:demo": "turbo run dev --filter=web --filter=api",
    "dev:beekeeper": "turbo run dev --filter=beekeeper"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
