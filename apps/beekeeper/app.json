{
  "expo": {
    "name": "beekeeper",
    "slug": "beekeeper",
    "version": "0.1.0",
    "scheme": "beekeeper",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow beekeeper to scan QR on honey jars"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow beekeeper to pin household location"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c2045e0c-2da0-4cc1-973c-e4005d6321e5"
      }
    },
    "owner": "ashutoshsononey",
    "android": {
      "package": "com.honeychain.beekeeper"
    }
  }
}
